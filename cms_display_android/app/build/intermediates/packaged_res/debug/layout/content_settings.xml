<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radio_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_cms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/source_cms"
                android:textColor="@color/white" />

            <RadioButton
                android:id="@+id/radio_usb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/source_usb"
                android:textColor="@color/white" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/section_cms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enter_mac"
                android:textColor="@color/white_70"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/mac_address"
                app:boxStrokeColor="@color/white_38"
                app:hintTextColor="@color/white_70"
                app:endIconMode="none">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_mac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:textColor="@color/white"
                    android:hint="@string/mac_hint" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/section_usb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_usb_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/usb_no_folder"
                android:textColor="@color/white_70"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_select_usb_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/select_usb_folder"
                android:backgroundTint="@color/green_700" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_save_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp"
            android:text="@string/save_and_play"
            android:backgroundTint="@color/green_700" />
    </LinearLayout>
</ScrollView>
